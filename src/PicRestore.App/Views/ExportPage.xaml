<Page
    x:Class="PicRestore.App.Views.ExportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Padding="24" Spacing="16" MaxWidth="420" HorizontalAlignment="Left">
        <TextBlock Text="Export format" FontWeight="SemiBold" />
        <RadioButtons x:Name="FormatButtons" SelectedIndex="0">
            <RadioButton Content="PNG (lossless, recommended for archival)" />
            <RadioButton Content="JPEG" />
        </RadioButtons>

        <TextBlock Text="JPEG quality" />
        <Slider x:Name="QualitySlider" Minimum="1" Maximum="100" Value="95" />

        <Button Content="Export..." Click="ExportButton_Click" HorizontalAlignment="Left" />
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
    </StackPanel>
</Page>
