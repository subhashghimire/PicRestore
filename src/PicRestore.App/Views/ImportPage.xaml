<Page
    x:Class="PicRestore.App.Views.ImportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <Button x:Name="ImportButton" Content="Import photo..." Click="ImportButton_Click" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>

        <Image Grid.Row="1" x:Name="PreviewImage" Stretch="Uniform" />

        <TextBlock Grid.Row="2" Text="Accepts JPEG, JPG, PNG, BMP and TIFF. The original file is never modified."
                   Opacity="0.7" />
    </Grid>
</Page>
